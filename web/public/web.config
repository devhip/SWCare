<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS (static export · trailingSlash) — หน้าแต่ละหน้าเป็น <route>/index.html จึงไม่ต้องมี rewrite
  ที่นี่ตั้งเฉพาะหน้า 404 ของแอป (out/404.html) แทนหน้า 404 ของ IIS
  deploy-iis.ps1 ไม่ทับ web.config บน server — site ที่มีอยู่แล้วจะเติมเฉพาะ httpErrors
-->
<configuration>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>
  </system.webServer>
</configuration>
