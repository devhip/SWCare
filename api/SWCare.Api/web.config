<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS (ASP.NET Core Module, in-process). dotnet publish fills in processPath / arguments.
  On the server this file also holds the environment variables (ConnectionStrings__SWCare, Jwt__Key, ...):
  scripts/deploy-iis.ps1 writes them the first time and never overwrites this file afterwards (docs/Deploy.md).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SWCare.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- 10 files x 20 MB + 1 MB (AttachmentRules.MaxRequestBytes); IIS stops at 30 MB by default -->
          <requestLimits maxAllowedContentLength="210763776" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
